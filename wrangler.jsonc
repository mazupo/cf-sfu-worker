{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-sfu-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // The demo pages are static. Only /sfu/* runs the Worker.
  // Generates src/proto and bundles the demo pages.
  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "demo", "external/protocol/protos"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/sfu/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "DEVICES", "class_name": "Device" },
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  // Never edit a deployed migration. Add a new tag instead.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Device", "Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],
  // Limits token requests per IP address. Counts are kept per Cloudflare location.
  "ratelimits": [
    { "name": "TOKEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "*",
    "TOKEN_TTL_SECONDS": "30",
    "DEVICE_STALE_SECONDS": "45",
    "WAKE_TIMEOUT_SECONDS": "20",
    "IDLE_LINGER_SECONDS": "30",
    "VIEWER_STALE_SECONDS": "45",
    "VIEWER_RESUME_SECONDS": "30",
    "MAX_VIEWERS_PER_DEVICE": "10",
    "MAX_DEVICES_PER_ROOM": "16",
    "MAX_ROOMS_PER_DEVICE": "4",
    "MAX_MICROPHONES_PER_ROOM": "10",
    // "true" opens /sfu/debug/* on this host, with a public key. They are open on localhost.
    "DEBUG_STATE": "false"
  },
  "observability": { "enabled": true },
  // Secrets: see .dev.vars.example.
  "env": {
    // The mazupo deployment: `wrangler deploy --env mazupo`. Other deployments can ignore it.
    // It repeats the settings above; `npm run check` checks that they match.
    "mazupo": {
      "workers_dev": false,
      "routes": [
        { "pattern": "api.mazupo.com/sfu", "zone_name": "mazupo.com" },
        { "pattern": "api.mazupo.com/sfu/*", "zone_name": "mazupo.com" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "DEVICES", "class_name": "Device" },
          { "name": "ROOMS", "class_name": "Room" },
          { "name": "REGISTRY", "class_name": "Registry" }
        ]
      },
      "ratelimits": [
        { "name": "TOKEN_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
      ],
      "vars": {
        "ALLOWED_ORIGINS": "*",
        "TOKEN_TTL_SECONDS": "30",
        "DEVICE_STALE_SECONDS": "45",
        "WAKE_TIMEOUT_SECONDS": "20",
        "IDLE_LINGER_SECONDS": "30",
        "VIEWER_STALE_SECONDS": "45",
        "VIEWER_RESUME_SECONDS": "30",
        "MAX_VIEWERS_PER_DEVICE": "10",
        "MAX_DEVICES_PER_ROOM": "16",
        "MAX_ROOMS_PER_DEVICE": "4",
        "MAX_MICROPHONES_PER_ROOM": "10",
        "DEBUG_STATE": "false"
      }
    }
  }
}
