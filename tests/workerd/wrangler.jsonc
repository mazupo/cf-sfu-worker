{
  // Test-only configuration. The keys below were generated for tests and are never deployed.
  "main": "../../src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "../../public", "binding": "ASSETS", "run_worker_first": ["/sfu/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "DEVICES", "class_name": "Device" },
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Device", "Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "*",
    "TOKEN_TTL_SECONDS": "30",
    "DEVICE_STALE_SECONDS": "45",
    "WAKE_TIMEOUT_SECONDS": "20",
    "IDLE_LINGER_SECONDS": "30",
    "VIEWER_STALE_SECONDS": "45",
    "VIEWER_RESUME_SECONDS": "30",
    "MAX_VIEWERS_PER_DEVICE": "2",
    "MAX_DEVICES_PER_ROOM": "3",
    "MAX_ROOMS_PER_DEVICE": "4",
    "MAX_MICROPHONES_PER_ROOM": "2",
    "DEBUG_STATE": "false",
    "REALTIME_SFU_APP_ID": "test-app",
    "REALTIME_SFU_BEARER_TOKEN": "test-sfu-token",
    "DEVICE_PRIVATE_KEY": "MC4CAQAwBQYDK2VwBCIEIHN-ekhY6SuL9x57SqskDiuXhXn6sH5BPGlR6wQOMwHR",
    "ADMIN_KEY": "test-admin-key",
    "VIEWER_PRIVATE_KEY": "MC4CAQAwBQYDK2VwBCIEIHr9d6ew9CX312fStL1XjFlSVEqgkA4geVaF7KDH_0Eb"
  }
}
