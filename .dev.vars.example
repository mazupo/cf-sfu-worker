# Copy to .dev.vars for `wrangler dev`. Deployed values are set with `wrangler secret put`.
# Realtime SFU app: Dashboard -> Realtime -> SFU -> create an application.
REALTIME_SFU_APP_ID=
REALTIME_SFU_BEARER_TOKEN=
# Run `npm run keys` and paste the private keys here. Give the public keys to devices and viewers.
DEVICE_PRIVATE_KEY=
VIEWER_PRIVATE_KEY=
# Optional. Adds TURN servers to the ICE servers sent to devices and viewers.
# REALTIME_TURN_KEY_ID=
# REALTIME_TURN_KEY_API_TOKEN=
# Optional. "true" turns on /sfu/debug/* on any host. On localhost it is always on.
# DEBUG_STATE=true
# Optional. Opens the dashboard (/sfu/admin/) on any host with this key. Without it, only on localhost.
# ADMIN_KEY=
# Optional. Both put the dashboard behind Cloudflare Access; ADMIN_KEY then no longer works.
# ACCESS_TEAM_DOMAIN=https://<your-team>.cloudflareaccess.com
# ACCESS_AUD=<the Access application's AUD tag>
